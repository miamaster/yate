[general]
; This section is special - holds settings common to all connections

; priority: int: Handler priority for kafka.send messages
;priority=100

; Each other section in this file describes a Kafka connection


;[default]
; The section name is used as the Kafka connection name

; enabled: bool: Enable/disable the account
;enabled=yes

; autostart: bool: Connect on module initialization
;autostart=yes

; brokers: string: Kafka bootstrap servers list (host:port,host:port)
;brokers=localhost:9092

; client_id: string: Kafka client identifier
;client_id=yate

; topic: string: Default topic used when message doesn't override it
;topic=yate-events

; acks: string: Required acknowledgements (all|0|1)
;acks=all

; compression: string: Compression type (gzip|snappy|lz4|zstd)
;compression=

; linger_ms: int: Linger time before sending batches
;linger_ms=0

; batch_size: int: Batch size in bytes
;batch_size=0

; message_timeout_ms: int: Message timeout in milliseconds
;message_timeout_ms=0

; request_timeout_ms: int: Request timeout in milliseconds
;request_timeout_ms=0

; send_retries: int: Retry count when queue is full
;send_retries=0

; flush_timeout_ms: int: Flush timeout after send (0 to skip flush)
;flush_timeout_ms=0

; security_protocol: string: Security protocol (plaintext|ssl|sasl_plaintext|sasl_ssl)
;security_protocol=

; sasl_mechanism: string: SASL mechanism (plain|scram-sha-256|scram-sha-512)
;sasl_mechanism=

; sasl_username: string: SASL username
;sasl_username=

; sasl_password: string: SASL password
;sasl_password=

; ssl_ca_location: string: Path to CA certificate
;ssl_ca_location=

; ssl_certificate_location: string: Path to client certificate
;ssl_certificate_location=

; ssl_key_location: string: Path to client key
;ssl_key_location=

; ssl_key_password: string: Password for client key
;ssl_key_password=
